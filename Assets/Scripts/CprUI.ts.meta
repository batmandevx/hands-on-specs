  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">CprUI – passive view for the CPR coach</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject cameraObject {"hint":"User camera (labels and buttons turn to face it)"}'
    - "// @input SceneObject startOrb {\"hint\":\"'Someone collapsed?' orb (collider + Interactable added here)\"}"
    - '// @input SceneObject startOrbVisual {"hint":"Orb sphere mesh"}'
    - '// @input SceneObject startOrbLabel {"hint":"Label above the orb"}'
    - '// @input SceneObject callCard {"hint":"Call card root (BackPlate)"}'
    - '// @input SceneObject callCardText {"hint":"Call card text"}'
    - '// @input SceneObject doneButton {"hint":"Call card Done button"}'
    - "// @input SceneObject chestPrompt {\"hint\":\"'Pinch the centre of the chest' prompt\"}"
    - '// @input SceneObject mannequinChest {"hint":"Mannequin chest wrapper (collider + Interactable added here)"}'
    - '// @input SceneObject mannequinChestVisual {"hint":"Mannequin chest mesh (hover tint)"}'
    - '// @input SceneObject handTarget {"hint":"Hand target (two stacked hands)"}'
    - '// @input SceneObject pacerRing {"hint":"Pacer ring root"}'
    - '// @input SceneObject pacerRingVisual {"hint":"Pacer ring mesh"}'
    - '// @input SceneObject counterText {"hint":"Counter text (1-30)"}'
    - '// @input SceneObject timerText {"hint":"Elapsed timer text"}'
    - '// @input SceneObject cueText {"hint":"Coaching cue text"}'
    - '// @input SceneObject swapCue {"hint":"Swap-rescuers cue"}'
    - '// @input SceneObject standClearCard {"hint":"Stand clear card root (BackPlate)"}'
    - '// @input SceneObject standClearCountdown {"hint":"Analyse countdown text inside the stand clear card"}'
    - '// @input SceneObject shockFlash {"hint":"Shock flash sphere"}'
    - '// @input SceneObject startButton {"hint":"Start button"}'
    - '// @input SceneObject skipButton {"hint":"Skip 2 minutes (dev/demo) button"}'
    - '// @input SceneObject aedHereButton {"hint":"AED here button"}'
    - '// @input SceneObject helpArrivedButton {"hint":"Help arrived button"}'
    - '// @input SceneObject shockButton {"hint":"Shock button"}'
    - '// @input SceneObject aedTray {"hint":"AED tray"}'
    - '// @input SceneObject padHint {"hint":"Pad hint text"}'
    - '// @input SceneObject pad1 {"hint":"Pad 1"}'
    - '// @input SceneObject pad2 {"hint":"Pad 2"}'
    - '// @input SceneObject pad1Ghost {"hint":"Pad 1 ghost outline"}'
    - '// @input SceneObject pad2Ghost {"hint":"Pad 2 ghost outline"}'
    - '// @input SceneObject pad1Label {"hint":"Label on pad 1"}'
    - '// @input SceneObject pad2Label {"hint":"Label on pad 2"}'
    - '// @input SceneObject summaryCard {"hint":"Handover summary card root (BackPlate)"}'
    - "// @input SceneObject restartButton {\"hint\":\"'Start again' button shown on the summary\"}"
    - '// @input SceneObject pushBar {"hint":"Push / rise depth-rhythm bar root (beside the hand target, opposite the counter)"}'
    - '// @input SceneObject viewArrow {"hint":"Out-of-view arrow root (child of the camera)"}'
    - '// @input Asset.Material overlayMaterial {"hint":"Transparent-capable material cloned for the push bar track and the arrow"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input vec4 accentColor = "{0.4, 1.0, 1.0, 1}" {"hint":"Primary accent (ring, counter)", "widget":"color"}'
    - '// @input vec4 attentionColor = "{1.0, 0.72, 0.15, 1}" {"hint":"Attention colour (swap cue, prompts)", "widget":"color"}'
    - '// @input vec4 textColor = "{1, 1, 1, 1}" {"hint":"Body text colour", "widget":"color"}'
    - "// @input string callMessage = \"Call 112 / 911 on speaker.|Shout for an AED.\" {\"hint\":\"Call card message ('|' starts a new line)\"}"
    - '// @input float ringDiameterCm = 20 {"hint":"Pacer ring outer diameter (cm)", "widget":"slider", "min":10, "max":30, "step":0.5}'
    - '// @input float ringWidthCm = 1.4 {"hint":"Pacer ring band width (cm)", "widget":"slider", "min":0.4, "max":4, "step":0.1}'
    - '// @input float pulseAmount = 0.15 {"hint":"Extra pulse size on each beat (0.15 = ring grows 15%)", "widget":"slider", "min":0, "max":0.4, "step":0.01}'
    - '// @input float pushBarHeightCm = 8 {"hint":"Push / rise bar height (cm)", "widget":"slider", "min":4, "max":14, "step":0.5}'
    - "// @input float pushShare = 0.45 {\"hint\":\"Share of each beat spent on 'push' (rest is 'let it rise')\", \"widget\":\"slider\", \"min\":0.2, \"max\":0.7, \"step\":0.01}"
    - '// @input float offViewDegrees = 22 {"hint":"Show the arrow when the chest is more than this many degrees off the view centre", "widget":"slider", "min":10, "max":40, "step":1}'
    - '// @ui {"widget":"group_end"}'
