  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">CprPad – drag-to-snap AED pad</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject ghost {"hint":"The glowing outline on the body this pad belongs on"}'
    - '// @input SceneObject padVisual {"hint":"Child with the pad mesh (tinted for hover / placed feedback)"}'
    - '// @input SceneObject ghostVisual {"hint":"Child with the ghost mesh (turns green when this pad is placed)"}'
