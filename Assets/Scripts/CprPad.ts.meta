    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input string wrongDropHint = "Upper right chest" {"hint":"Placement label shown on the body outline, and as the hint when the pad is dropped in the wrong place"}'
    - '// @input SceneObject cameraObject {"hint":"Camera the outline label turns to face (optional)"}'
    - "// @input vec3 labelOffset = \"{0, 1, 7.5}\" {\"hint\":\"Where the outline label floats, in the ghost's local space (cm)\"}"
