    - '// @input float outlineWidthCm = 0.7 {"hint":"Outline band width (cm)", "widget":"slider", "min":0.2, "max":2, "step":0.1}'
    - '// @input float glowPulseHz = 0.9 {"hint":"Glow pulse speed (pulses per second)", "widget":"slider", "min":0, "max":3, "step":0.1}'
    - '// @input float snapDistanceCm = 8 {"hint":"Snap if released within this distance (cm) of its own ghost", "widget":"slider", "min":2, "max":15, "step":0.5}'
    - '// @input vec4 idleColor = "{0.95, 0.95, 0.95, 1}" {"hint":"Pad colour while waiting on the tray", "widget":"color"}'
    - '// @input vec4 hoverColor = "{0.45, 1.0, 1.0, 1}" {"hint":"Pad colour while aimed at / held", "widget":"color"}'
    - '// @input vec4 placedColor = "{0.35, 1.0, 0.45, 1}" {"hint":"Pad + ghost colour once correctly placed", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
