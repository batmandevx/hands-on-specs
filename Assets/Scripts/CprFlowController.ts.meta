  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">CprFlowController – CPR coach flow + pacer</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 ui {"hint":"View module that renders every step (passive view)"}'
    - '// @input AssignableType_2 pad1 {"hint":"Pad 1 (upper right chest) drag component"}'
    - '// @input AssignableType_3 pad2 {"hint":"Pad 2 (lower left side) drag component"}'
    - '// @input SceneObject chestAnchor {"hint":"Lower-sternum anchor on the mannequin chest; pacer content is parented here"}'
    - '// @input Asset.AudioTrackAsset clickTrack {"hint":"Metronome click played on every beat (spatial, from the chest)"}'
    - '// @input Asset.AudioTrackAsset chimeTrack {"hint":"Chime played when it is time to swap rescuers"}'
    - '// @input Asset.AudioTrackAsset zapTrack {"hint":"Zap played when the shock is delivered"}'
    - '// @input AssignableType_4 voice {"hint":"Spoken coaching lines (own AudioComponent, separate from the click)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float bpm = 110 {"hint":"Compression rate in beats per minute (guidance: 100-120)", "widget":"slider", "min":100, "max":120, "step":1}'
    - '// @input float counterMax = 30 {"hint":"Counter loops from 1 up to this value (30 compressions per set)", "widget":"slider", "min":10, "max":30, "step":1}'
    - "// @input float swapIntervalSeconds = 120 {\"hint\":\"Seconds of elapsed time between 'switch rescuers' cues\", \"widget\":\"slider\", \"min\":30, \"max\":240, \"step\":10}"
    - '// @input float swapCueSeconds = 5 {"hint":"How long the swap cue stays up before clearing itself", "widget":"slider", "min":1, "max":10, "step":0.5}'
    - "// @input float analyseSeconds = 3 {\"hint\":\"Length of the AED 'analysing' countdown before Shock appears\", \"widget\":\"slider\", \"min\":1, \"max\":6, \"step\":1}"
    - '// @input float markToleranceCm = 3 {"hint":"How far (cm) the hand target may follow the pinch away from the lower sternum", "widget":"slider", "min":0, "max":6, "step":0.5}'
    - '// @input float clickVolume = 0.8 {"hint":"Click volume", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input bool voiceEnabled = true {"hint":"Speak a coaching line on each step (hands are busy, so audio leads)"}'
    - '// @input float voiceDuck = 0.5 {"hint":"Click volume multiplier while a voice line plays (0.5 = duck by half)", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - "// @input float keepGoingSeconds = 30 {\"hint\":\"Seconds of compressing between 'keep going' encouragements\", \"widget\":\"slider\", \"min\":10, \"max\":90, \"step\":5}"
    - '// @ui {"widget":"group_end"}'
