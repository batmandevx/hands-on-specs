  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">CprDemoDriver – dev-only scripted walkthrough</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 controller {"hint":"Flow controller to drive"}'
    - '// @input AssignableType_2 pad1 {"hint":"Pad 1 component"}'
